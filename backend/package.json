{
  "name": "crewboard-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "prisma": {
    "schema": "prisma/generated.prisma"
  },
  "scripts": {
    "postinstall": "npm run db:generate",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "start:prod": "npm run db:push && tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "db:generate": "node scripts/prisma-provider.mjs && prisma generate",
    "db:push": "node scripts/prisma-provider.mjs && prisma db push --skip-generate",
    "db:seed": "npm run db:generate && tsx prisma/seed.ts",
    "db:reset": "npm run db:generate && prisma db push --force-reset --skip-generate && tsx prisma/seed.ts --reset",
    "setup": "npm run db:generate && prisma db push --skip-generate && tsx prisma/seed.ts",
    "studio": "node scripts/prisma-provider.mjs && prisma studio"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie": "^0.7.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "google-auth-library": "^9.15.1",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.22.0",
    "socket.io": "^4.8.1",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie": "^0.6.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "typescript": "~5.6.3"
  }
}
