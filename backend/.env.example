PORT=4000
DATABASE_URL="file:./dev.db"
# Use a long random string in production
JWT_SECRET="change-me-to-a-long-random-string"
# OAuth Client ID from Google Cloud Console (APIs & Services → Credentials). Leave empty to hide "Continue with Google".
GOOGLE_CLIENT_ID=""
# Site admins (comma-separated). They get /admin once their email is confirmed.
ADMIN_EMAILS=""
# "true" = signup sends a confirmation link and email invites need a confirmed email. Off by default.
REQUIRE_EMAIL_CONFIRMATION="false"
# Built-in admin with a password (no personal Gmail). Created/updated on every start.
SITE_ADMIN_EMAIL=""
SITE_ADMIN_PASSWORD=""
# Email via Brevo's HTTPS API instead of SMTP (if your host blocks SMTP). Uses MAIL_FROM as the sender.
BREVO_API_KEY=""
# Password-reset emails. Leave SMTP_HOST empty to print reset links in the server log instead.
APP_URL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM=""
# Where the frontend runs (used for CORS when not using the Vite proxy)
CLIENT_ORIGIN="http://localhost:5173"
